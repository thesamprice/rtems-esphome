# Every input to this port is a submodule with a recorded pin, and none of them
# are fetched by default.  A plain clone stays small; each script fetches what it
# needs.  Fetch one explicitly with:
#
#     git submodule update --init --checkout --depth=1 src/<name>
#
# The pin is what makes a result attributable.  "branch" only says where to look
# when a pin is deliberately moved forward:
#
#     git submodule update --remote src/esphome
#
# scripts/manifest.sh reports what is checked out against what is recorded here,
# and exits non-zero if they disagree.

[submodule "src/esp-qemu"]
	path = src/esp-qemu
	# Espressif's QEMU fork, forked again so the two ESP32-C3 fixes this port
	# needs are commits rather than patch files.  Branch esp32c3-rtems-fixes
	# is esp-develop-9.2.2-20260417 plus:
	#
	#   3d3909d  hw/riscv/esp32c3_intmatrix: Implement INTR_STATUS_0 and _1
	#   69094f5  hw/timer/esp_systimer: Carry the ns-to-ticks remainder
	#
	# Both are candidates for espressif/qemu and neither is RTEMS-specific.
	# When they land upstream, point this back at espressif/qemu and drop the
	# branch.
	url = git@github.com:thesamprice/qemu.git
	# The same over https, when there is no key on the machine:
	#url = https://github.com/thesamprice/qemu.git
	# Upstream, which does NOT contain the two fixes:
	#url = https://github.com/espressif/qemu.git
	branch = esp32c3-rtems-fixes
	update = none

[submodule "src/esphome"]
	path = src/esphome
	# The thing being ported, forked so the RTEMS backend is commits rather
	# than a patch set.  Python validation and code generation plus the C++
	# runtime; the port touches both.
	#
	# Branch "rtems" starts at 58ca345, which is upstream dev at the time the
	# pin was taken.  A platform backend is not a small diff -- it adds a
	# platform component, a core/wake/wake_rtems.*, a Python build target, a HAL
	# header and USE_RTEMS through defines.h -- and rebasing a patch set that
	# size by hand against a tree that moves daily is the failure mode patches/
	# exists to avoid rather than an instance of it.  ESPHome takes new
	# platforms upstream; Zephyr and LibreTiny both arrived that way, so the end
	# state is a pull request and a fork is the form that ends in.
	#
	# Upstream dev moves fast.  Rebase deliberately and record the new pin here
	# rather than letting the branch drift, because the pin is what makes a
	# result attributable.
	url = git@github.com:thesamprice/esphome.git
	# The same over https, when there is no key on the machine:
	#url = https://github.com/thesamprice/esphome.git
	# Upstream, which does NOT contain the RTEMS backend.  "dev" is its default
	# branch and its development line; there is no "main" here.
	#url = https://github.com/esphome/esphome.git
	branch = rtems
	update = none

[submodule "src/osal"]
	path = src/osal
	# NASA OSAL.  A selective building block, not the foundation -- see
	# docs/architecture.md for what it is and is not used for.  Its RTEMS
	# backend is first-party and lives in src/os/rtems; there is no FreeRTOS
	# backend upstream.
	#
	# Note the default branch is "dev", not "main".
	url = https://github.com/nasa/osal.git
	branch = dev
	update = none

[submodule "src/rtems"]
	path = src/rtems
	# RTEMS itself.  main IS the 7 development line; a release line gets a
	# branch only once it is cut, so there is no "7".
	url = https://gitlab.rtems.org/rtems/rtos/rtems.git
	# Over ssh, which needs a key on gitlab.rtems.org port 2222:
	#url = ssh://git@gitlab.rtems.org:2222/rtems/rtos/rtems.git
	branch = main
	update = none

[submodule "src/rtems-lwip"]
	path = src/rtems-lwip
	# The network stack M3 uses.  Chosen over libbsd in #50 and confirmed by
	# building it: 391 files against libbsd's 5,602, an explicit
	# arm/xilinx_zynq_a9_qemu target, and sockets that are RTEMS file
	# descriptors, so select() spans sockets and files and ESPHome's existing
	# socket backend needs no new implementation.
	#
	# Fetched from the GitHub mirror rather than gitlab.rtems.org.  Not a
	# preference: gitlab has been refusing connections on port 2222 for the
	# whole of this work, and treating that as a blocker cost #50 several
	# sessions of being deferred for no reason.  The mirror is current --
	# it was last pushed the same week.
	#
	# It has submodules of its own, lwip-upstream and rtems_waf, which
	# ./waf configure needs, so this one is not useful shallow.
	url = https://github.com/RTEMS/rtems-lwip.git
	branch = main
	update = none

[submodule "src/rtems-libbsd"]
	path = src/rtems-libbsd
	# The FreeBSD-derived stack.  Kept, not used: #50 chose lwip, and the
	# reason is size -- 2.6M lines against lwip's 148k, which is not a
	# candidate on a part with 320 KiB of RAM whatever it can do on a Zynq.
	# Here so the comparison can be repeated rather than taken on trust.
	#
	# Branches are named for both the RTEMS series and the FreeBSD baseline,
	# so the 7 line is 7-freebsd-14 and there is no main branch at all.
	#
	# Heavier than an MCU lwIP configuration; the footprint is recorded at the
	# first networking milestone rather than argued about.
	url = https://gitlab.rtems.org/rtems/pkg/rtems-libbsd.git
	branch = 7-freebsd-14
	update = none

[submodule "src/rsb"]
	path = src/rsb
	# The RTEMS Source Builder, which is what produces the cross toolchain the
	# RTEMS lane needs.  Declared because CI has to build one from nothing: a
	# developer usually has $HOME/rtems/7 already, a runner never does.
	#
	# Building a toolchain takes tens of minutes, so CI caches the result on
	# this pin; the pin is therefore what a cached toolchain is attributable to.
	#
	# Pinned at 105f43d299cb5c367fc5f2b0147f401721ed3d9c, which is the revision that
	# built the riscv-rtems7 toolchain this port has been developed and tested
	# against -- not whatever main happens to be, so the toolchain in CI is the
	# one the results came from.
	url = https://gitlab.rtems.org/rtems/tools/rtems-source-builder.git
	branch = main
	update = none
